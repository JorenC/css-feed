# Discord application credentials (Discord Developer Portal)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# HTTP server
PORT=3000

# Optional: if set, GET requests to the API must send this in an
# `X-Api-Key` header. Leave blank to leave the feed open (fine for local dev).
API_KEY=

# Optional: CORS origin allowed to read the feed from a browser (e.g. the
# consuming live app's URL). Defaults to * (any origin) if unset.
ALLOWED_ORIGIN=*

# Where the SQLite file lives. On Railway, point this at a mounted Volume
# (e.g. /data/css-feed.db) so the feed + watched-channel selection survive
# redeploys. Defaults to ./data/css-feed.db otherwise.
DB_PATH=./data/css-feed.db

# How many messages to retain per watched channel.
MAX_MESSAGES_PER_CHANNEL=100
